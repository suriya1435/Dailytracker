<ContentPage
    x:Class="DailyTrack.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="DailyTrack"
    BackgroundColor="#F4F6FB">

	<ScrollView>
		<VerticalStackLayout Padding="22" Spacing="20">

			<!-- App Branding -->
			<Label
                Text="DAILYTRACK"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#5267D9"
                CharacterSpacing="2" />

			<Label
                Text="Your money,&#10;under control."
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#172033" />

			<!-- Current Date -->
			<Label
                x:Name="DateLabel"
                Text="Today's Overview"
                FontSize="14"
                TextColor="#68738A" />

			<!-- Available Balance Card -->
			<Border
                BackgroundColor="#5267D9"
                StrokeThickness="0"
                Padding="22"
                StrokeShape="RoundRectangle 24">

				<VerticalStackLayout Spacing="12">

					<Label
                        Text="AVAILABLE BALANCE"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#E0E5FF"
                        CharacterSpacing="2" />

					<Label
                        x:Name="BalanceLabel"
                        Text="₹0.00"
                        FontSize="36"
                        FontAttributes="Bold"
                        TextColor="White" />

					<BoxView
                        HeightRequest="1"
                        BackgroundColor="#8290ED"
                        Opacity="0.8" />

					<Label
                        Text="Total income minus total expenses"
                        FontSize="13"
                        TextColor="#E0E5FF" />

				</VerticalStackLayout>
			</Border>

			<!-- Income and Expense Summary -->
			<Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

				<!-- Income Card -->
				<Border
                    Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#E7EAF2"
                    Padding="16"
                    StrokeShape="RoundRectangle 18">

					<VerticalStackLayout Spacing="10">

						<Label
                            Text="💰 Income"
                            FontSize="14"
                            TextColor="#68738A" />

						<Label
                            x:Name="IncomeLabel"
                            Text="₹0.00"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#15966A"
                            LineBreakMode="WordWrap" />

						<Label
                            Text="Money received"
                            FontSize="11"
                            TextColor="#8992A5" />

					</VerticalStackLayout>
				</Border>

				<!-- Expense Card -->
				<Border
                    Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="#E7EAF2"
                    Padding="16"
                    StrokeShape="RoundRectangle 18">

					<VerticalStackLayout Spacing="10">

						<Label
                            Text="💸 Expenses"
                            FontSize="14"
                            TextColor="#68738A" />

						<Label
                            x:Name="ExpenseLabel"
                            Text="₹0.00"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#E45757"
                            LineBreakMode="WordWrap" />

						<Label
                            Text="Money spent"
                            FontSize="11"
                            TextColor="#8992A5" />

					</VerticalStackLayout>
				</Border>

			</Grid>

			<!-- Quick Actions -->
			<Label
                Text="Quick Actions"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#172033" />

			<!-- Add Expense -->
			<Button
                x:Name="AddExpenseButton"
                Text="+ Add Expense"
                BackgroundColor="#5267D9"
                TextColor="White"
                CornerRadius="15"
                HeightRequest="55"
                FontAttributes="Bold"
                Clicked="OnAddExpenseClicked" />

			<!-- Add Income -->
			<Button
                x:Name="AddIncomeButton"
                Text="+ Add Income"
                BackgroundColor="#15966A"
                TextColor="White"
                CornerRadius="15"
                HeightRequest="55"
                FontAttributes="Bold"
                Clicked="OnAddIncomeClicked" />

			<!-- Financial Reports -->
			<Button
                x:Name="ReportsButton"
                Text="📊 View Financial Reports"
                BackgroundColor="#172554"
                TextColor="White"
                CornerRadius="15"
                HeightRequest="55"
                FontSize="16"
                FontAttributes="Bold"
                Clicked="OnReportsClicked" />

			<!-- Transaction History -->
			<Label
                Text="Recent Transactions"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#172033"
                Margin="0,8,0,0" />

			<!-- Search Transactions -->
			<Entry
                x:Name="SearchEntry"
                Placeholder="Search category or notes..."
                BackgroundColor="White"
                TextColor="#172033"
                PlaceholderColor="#8992A5"
                ClearButtonVisibility="WhileEditing"
                TextChanged="OnSearchTextChanged" />

			<!-- Transaction Filter -->
			<Picker
                x:Name="TypeFilterPicker"
                Title="Filter transactions"
                BackgroundColor="White"
                TextColor="#172033"
                SelectedIndex="0"
                SelectedIndexChanged="OnFilterChanged">

				<Picker.Items>
					<x:String>All Transactions</x:String>
					<x:String>Income Only</x:String>
					<x:String>Expenses Only</x:String>
				</Picker.Items>

			</Picker>

			<!-- Transaction List -->
			<VerticalStackLayout
                x:Name="TransactionsLayout"
                Spacing="10">

				<Label
                    Text="No transactions yet. Add your first income or expense!"
                    TextColor="#68738A"
                    FontSize="14" />

			</VerticalStackLayout>

			<!-- Company Footer -->
			<VerticalStackLayout
                Spacing="5"
                Margin="0,15,0,10"
                HorizontalOptions="Fill">

				<Label
                    Text="DailyTrack"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="#5267D9"
                    HorizontalTextAlignment="Center" />

				<Label
                    Text="Powered by Suriyatechnologies"
                    FontSize="12"
                    TextColor="#8992A5"
                    HorizontalTextAlignment="Center" />

			</VerticalStackLayout>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
